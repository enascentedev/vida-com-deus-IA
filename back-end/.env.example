# Copie este arquivo para .env e preencha os valores.
# O .env é ignorado pelo git — nunca versione segredos reais.
#
# JWT_SECRET_KEY e DATABASE_URL não têm valor padrão: a aplicação não sobe sem
# eles. Valide a configuração com:
#
#   uv run python -m app.core.config_check

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Vida com Deus API"
APP_VERSION="0.1.0"
DEBUG=false
# development | staging | production
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista JSON das origens permitidas.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── JWT ───────────────────────────────────────────────────────────────────────
# Obrigatório. Mínimo de 32 caracteres. Gere um segredo novo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Valores de exemplo ("change-me", "secret", ...) são recusados na inicialização.
JWT_SECRET_KEY=
# Permitidos: HS256, HS384, HS512
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Banco de dados ────────────────────────────────────────────────────────────
# Obrigatório. Precisa usar o driver async psycopg 3 (postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/vida_com_deus

# Banco isolado para a suíte de testes — precisa ser diferente do banco de
# desenvolvimento: as tabelas são truncadas entre os testes.
TEST_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/vida_com_deus_test

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Sem esta chave o chat responde com um stub declarado como simulado em
# desenvolvimento, e falha com 503 quando ENVIRONMENT=production.
OPENAI_API_KEY=

# ── Render — plano do banco de dados (tamanho em bytes) ────────────────────────
# Free: 1073741824 (1 GB) | Starter: 10737418240 (10 GB) | Standard: 37580963840 (35 GB)
RENDER_DB_SIZE_BYTES=1073741824

# ── Redis (Fase 3 — ainda não utilizado pela aplicação) ───────────────────────
REDIS_URL=redis://localhost:6379/0
